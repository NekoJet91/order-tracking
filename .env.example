# Copy to .env to override anything below; compose reads that file without being told.
# Nothing here is required — every value has the same default built into docker-compose.yml,
# so `docker compose up --build` works on a clean clone with no .env at all.

# Where the stack appears on the host. Change these if something already holds the port.
CLIENT_PORT=8080
API_PORT=5138
RABBITMQ_MANAGEMENT_PORT=15673
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090

# Credentials. These are demo values and live in the repository on purpose; a real deployment
# supplies them from its own secret store and never from a file next to the source.
POSTGRES_DB=ordertracking
POSTGRES_USER=ordertracking
POSTGRES_PASSWORD=ordertracking
RABBITMQ_USER=ordertracking
RABBITMQ_PASSWORD=ordertracking

# Development turns on Swagger at /swagger and the developer exception page.
ASPNETCORE_ENVIRONMENT=Production

# The background job that creates orders and walks them through statuses by itself. Useful for
# watching the socket work without clicking; leave it off if you want a quiet database.
SIMULATOR=false
